# CPS AI Guidebook MCP — Environment Variables
#
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# Domain for reverse proxy (Nginx Proxy Manager or Caddy)
# Leave empty for local development
PUBLIC_HOST=

# Optional API key for OAuth authentication
# Leave empty for no authentication
MCP_API_KEY=

# Port mappings
MCP_PORT=8080
DASHBOARD_PORT=8050

# Dashboard URL base path
DASH_URL_BASE=/reporting/

# Log settings
MAX_LOG_LINES=10000
