# OpenAI US Privacy Policy MCP — Environment Variables
#
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# Domain for reverse proxy (Caddy or Nginx Proxy Manager)
# Leave empty for local development
PUBLIC_HOST=

# Optional API key for OAuth authentication
# Leave empty for no authentication
MCP_API_KEY=

# Port mapping
MCP_PORT=8080

# Dashboard URL base path (standalone mode only — embedded mode ignores this)
DASH_URL_BASE=/reporting/

# Log settings
MAX_LOG_LINES=10000
